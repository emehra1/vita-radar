{
  "name": "vita-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepipeline": "bash scripts/assert-fresh.sh",
    "pipeline": "tsx pipeline/run.ts",
    "email": "node --env-file-if-exists=.env --import tsx scripts/send-email.ts",
    "ics": "tsx scripts/build-ics.ts",
    "validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-sources": "tsx scripts/check-sources.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "js-yaml": "^4.3.2",
    "nodemailer": "^6.9.5",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.5",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
