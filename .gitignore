node_modules
.next

# Build output is disposable EXCEPT the calendar.
#
# out/calendar.ics is the one artifact that must outlive a broken pipeline: it is
# the file the user subscribes to in Google Calendar, so once it is committed the
# deadlines keep arriving even if this repo stops running for a month. Ignoring
# it produced a failure indistinguishable from success -- the ICS built fine every
# day and nothing was ever published.
#
# Note the `out/*` form rather than `out/`: git cannot un-ignore a path inside an
# ignored DIRECTORY, so the directory itself must stay tracked for the negation
# below to have anything to apply to.
out/*
!out/calendar.ics
.DS_Store
.env
.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# build artifacts
*.tsbuildinfo

# derived at build time from data/ — never committed
public/data/

# raw fetched bodies (large, copyrighted); http-meta.json IS committed
.cache/raw/

# local email previews
.preview/

# legacy artifact of the old generate-summary script
summary.json
