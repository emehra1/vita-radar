# Everything here is OPTIONAL for local use. The pipeline, the calendar build and
# the email PREVIEW all run with no configuration at all — `npm run email`
# renders to .preview/ and sends nothing, because sending requires an explicit
# `--send`. These variables only matter when you actually want mail to leave the
# machine, or when a source refuses to answer an anonymous client.
#
# In CI these live as GitHub repository secrets, never in a file. Copy to .env
# for local use; .env is gitignored.

SMTP_HOST=smtp.gmail.com
# 465 (implicit TLS) or 587 (STARTTLS). Port 25 is blocked on GitHub's runners,
# so a config that works on your laptop over 25 fails only in CI, at 10:47, once
# a day, silently.
SMTP_PORT=465
SMTP_USER=you@gmail.com
# Gmail requires an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords). Your normal login password will not work and
# "less secure app access" no longer exists.
#
# ⚠️ DO NOT use an @college.harvard.edu address as the sender. It is a Google
# Workspace account owned by the university: an admin can revoke app passwords
# or disable SMTP for the whole domain without telling you, and the failure
# arrives as a run of mornings with no email. Whatever this system is for, the
# thing it is protecting is a set of once-a-year deadlines, so its delivery path
# should not depend on somebody else's IT policy. Use a personal account.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# For Gmail this must be the same address as SMTP_USER, or Gmail rewrites the
# From header and DMARC alignment suffers — which lands the digest in spam,
# where its absence looks like the pipeline being broken.
MAIL_FROM="Vita Radar <you@gmail.com>"
MAIL_TO=you@gmail.com

# Used for the "view on the web" link in the email, and for the subscribe URL of
# the .ics feed. Leave it unset until phase 2 puts a site somewhere: the renderer
# omits the link rather than printing one that 404s.
# SITE_URL=https://you.github.io/vita-radar/

# Phase 3, and the layer is a NO-OP without it. Claude is a locator, never a
# reader of record: it may propose a date into a `proposed*` field and open a
# pull request for a human to merge, and it may write the optional editorial
# paragraph that renders last. It may never write config/deadlines.yml, never
# contribute a score factor (CI asserts that), and never sit in the alert path.
# With this unset every one of those paths is skipped and the digest is
# byte-identical apart from the missing editorial line.
# ANTHROPIC_API_KEY=sk-ant-...

# Dead-man's switch (healthchecks.io or equivalent). The pipeline pings this URL
# after a successful send, and if no ping arrives inside the grace window the
# service emails you. This is the only alarm that does not share a failure domain
# with what it monitors — it fires when GitHub drops the cron, when the scheduled
# workflow is auto-disabled after 60 days of repo inactivity, when SMTP breaks,
# and when the runner never starts. Unset means the ping step no-ops.
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# MANDATORY rather than optional, for anything that touches SEC EDGAR. EDGAR
# returns 403 to a client without a descriptive User-Agent carrying a real
# contact email — it is their stated fair-access policy, not a bot filter to work
# around, and the 403 is total: no data, no partial answer. Format is the one
# they ask for: "Name contact@example.com".
SEC_USER_AGENT="Your Name you@example.com"
